# ============================================================
# ContractLens — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- Database ---
DATABASE_URL=postgresql://ContractLens:ContractLens_secret@localhost:5432/ContractLens_db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Groq LLM ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile

# --- Auth / Security ---
SECRET_KEY=change_this_to_a_long_random_secret_key_32_chars_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Encryption (for MCP credentials at rest) ---
ENCRYPTION_KEY=change_this_to_a_32_byte_base64_encoded_key

# --- ContractLens Business Rules ---
# Dollar threshold above which human approval is always required
APPROVAL_THRESHOLD_USD=5000
# Minimum LLM confidence score; below this → manual review
LLM_CONFIDENCE_THRESHOLD=0.6
# Days after action execution to run the verification check
VERIFICATION_DAYS=30
# Cron expression for the daily ingestion scan (default: 2am daily)
SCAN_SCHEDULE_CRON=0 2 * * *

# --- MCP Settings ---
# Set to true to use mock MCP servers (no live credentials required for dev)
MOCK_MCP=true

# --- Email (optional, for email-based approval notifications) ---
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_password
MAIL_FROM=noreply@ContractLens.ai
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# --- Frontend URL (for deep-links in notifications) ---
FRONTEND_URL=http://localhost:3000

