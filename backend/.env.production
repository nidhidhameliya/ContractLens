# ============================================================
# ContractLens - PRODUCTION Environment Variables
# Fill these in on your hosting platform (Render / Vercel)
# NEVER commit this file with real values to GitHub!
# ============================================================

# --- Database (get from Render or Neon.tech) ---
DATABASE_URL=postgresql://ContractLens:YOUR_PASSWORD@YOUR_HOST:5432/ContractLens_db

# --- Redis (get from Render or Upstash) ---
REDIS_URL=redis://default:YOUR_PASSWORD@YOUR_HOST:6379

# --- Groq (FREE LLM - get at console.groq.com) ---
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# --- Security ---
SECRET_KEY=GENERATE_WITH: python -c "import secrets; print(secrets.token_hex(32))"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Encryption Key ---
ENCRYPTION_KEY=GENERATE_WITH: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- MCP (keep true for free/demo) ---
MOCK_MCP=true

# --- Email (use Gmail App Password - free) ---
MAIL_USERNAME=your.gmail@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM=noreply@gmail.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# --- URLs ---
FRONTEND_URL=https://your-ContractLens.vercel.app
AGENT_SERVICE_URL=https://ContractLens-agent.onrender.com

# --- LangSmith Tracing (optional, free tier available) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ContractLens

